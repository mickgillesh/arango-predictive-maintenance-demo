# ArangoDB cloud instance
ARANGO_URL=https://<your-instance>.arango.cloud/
ARANGO_DB=predictive-maintenance
ARANGO_USER=<service-account-user>
ARANGO_PASSWORD=<service-account-password>

# LangChain / OpenAI — AI-assisted AQL query generation and technician note embeddings
# The app uses ArangoGraphQAChain to translate natural-language questions into
# AQL, execute them against the database, and return a natural-language answer.
# Also used by `make embed` to generate text-embedding-3-small embeddings on engine nodes.
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o   # optional; default is gpt-4o

# Google OAuth 2.0 — restrict login to @arangodb.com accounts
# Create credentials at https://console.cloud.google.com/apis/credentials
# Application type: Web application
# Authorised redirect URIs:
#   https://<your-deployed-domain>/auth/callback
#   http://localhost:8080/auth/callback   (local dev)
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Optional: override the OAuth redirect URI for prod (needed behind HTTPS proxies)
# GOOGLE_REDIRECT_URI=https://<your-deployed-domain>/auth/callback
# Optional: persist sessions across container restarts (auto-generated per-process if unset)
# SESSION_SECRET=<run: python -c "import secrets; print(secrets.token_hex(32))">

# Optional: comma-separated engine IDs pinned to critical for rehearsed demos
# FORCED_CRITICAL=42,7

# Scorer sidecar URL — if set, the backend delegates startup scoring to this
# container instead of running the scorer inline. Used with docker-compose or
# when the scorer is deployed as a separate container (e.g. ArangoDB BYOC).
# SCORER_URL=http://scorer:8001

# ArangoDB Custom Retriever (AI Suite) — enables the "Technical Requirements"
# panel in the Work Order Drawer. Set up by:
#   1. Ingest data/technicians_documentation/*.md via the Autograph web UI (project: technicians_documentation)
#   2. Run: uv run python scripts/setup_retriever.py
#   3. Set RETRIEVER_URL below; restart the server
# If RETRIEVER_URL is unset the panel gracefully shows "service not configured".
# Authentication is automatic — ARANGO_USER / ARANGO_PASSWORD are reused to fetch a JWT.
#
# RETRIEVER_URL format: https://<endpoint>:8529/graphrag/retriever/<service_id>/v1
# RETRIEVER_URL=https://<your-endpoint>:8529/graphrag/retriever/<service_id>/v1
# RETRIEVER_TOOL_ID=aerofleet_techdocs_v1   # _key of tool doc inserted by setup_retriever.py
