# ── ArangoDB (the fresh enablement cluster) ──────────────────────────────────
# ARANGO_URL is the deployment endpoint, port included, no trailing slash,
# e.g. https://<deployment>.arango.ai:8529
ARANGO_URL=https://<your-deployment>:8529
# The loader refuses to run unless the database name contains "aerofleet".
ARANGO_DB=aerofleet_enablement
ARANGO_USER=<service-account-user>
ARANGO_PASSWORD=<service-account-password>
# TLS certificate check: true (default), false (skip the check for a self-signed
# cluster certificate), or a CA bundle path. On the platform notebook server the notebook defaults to
# $ARANGO_DEPLOYMENT_CA (the cluster CA, e.g. /etc/deployment-int/ca/ca.crt).
ARANGO_TLS_VERIFY=true

# ── LLM provider (OpenAI) ────────────────────────────────────────────────────
# Used by `make embed` (technician-note embeddings on engines) and by the
# notebook to create AI Suite secret profiles for AutoGraph / AutoRAG.
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o
# Must be the SAME model AutoRAG uses, or semantic search over
# engines.notesEmbedding compares vectors from different spaces.
EMBEDDING_MODEL=text-embedding-3-small

# Optional: comma-separated engine IDs pinned to critical for rehearsed demos
# FORCED_CRITICAL=42,7

# ── AI Suite (AutoGraph / AutoRAG) ───────────────────────────────────────────
# Full AutoGraph project name. Projects cannot be deleted via the SDK, so if
# this is unset the notebook creates a fresh one per run (aerofleet_docs_<MMDDHHMM>)
# and prints it. Set it to that printed name to reuse a project, or for
# `make tools`.
# PROJECT_NAME=aerofleet_docs_11101400
# ArangoDB user AutoGraph uses to resume File Parser work after a pod restart.
# Needs read/write on ARANGO_DB. The SDK does NOT create this user.
FPS_RECOVERY_USERNAME=<db-user>
# Collection the Retriever reads Custom Retriever tool docs from.
# Verified on the platform: the Retriever reads the shared "Tools" collection
# (the docs say "{project}_Tools"). Empty = "Tools".
# TOOLS_COLLECTION=
